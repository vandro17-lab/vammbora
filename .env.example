# ==========================================================================
# Vambora — variáveis de ambiente (EXEMPLO)
# --------------------------------------------------------------------------
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA commite o arquivo ".env" real (ele está no .gitignore).
# NUNCA cole a chave "service_role" / secret aqui nem no frontend.
# ==========================================================================

# URL pública do projeto Supabase (aparece no painel do Supabase).
# Projeto "vambora":
VITE_SUPABASE_URL=https://rnulmjdsvvuirqijemzy.supabase.co

# Chave PÚBLICA (anon) do Supabase. Pode ficar no frontend DESDE QUE as
# políticas RLS estejam corretas (elas estão). Projeto "vambora":
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJudWxtamRzdnZ1aXJxaWplbXp5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTM3NDk5NjIsImV4cCI6MjEwOTMyNTk2Mn0.Cbne-PvsCtoLcSHgLk89DwmU-bSMPYJvRy61B7_g3a4

# Liga/desliga a camada real do Supabase.
#   "true"  = a vitrine e o painel usam o banco (produção/demonstração real).
#   "false" = usa dados de exemplo locais (sem banco).
VITE_USE_SUPABASE=true

# --------------------------------------------------------------------------
# SERVIDOR (NÃO vão para o frontend) — usados por /api/buscar-rotas (Vercel).
# --------------------------------------------------------------------------
# Chave SECRETA service_role do Supabase. NUNCA no frontend. Configure apenas
# como Environment Variable no servidor (Vercel). Sem ela, a busca por rotas
# reais responde 503.
# SUPABASE_SERVICE_ROLE_KEY=coloque-no-painel-do-vercel

# MODO DEMONSTRAÇÃO da busca (§6.1). Só o SERVIDOR liga; o navegador NÃO ativa.
#   "1" ou "true" = a busca /api/buscar-rotas passa a INCLUIR as rotas
#                   demonstrativas (is_demo=true) além das reais. Cada resultado
#                   vem marcado com demo=true (selo "Demonstração" no cartão).
#   ausente/"0"   = produção normal: rotas demonstrativas são EXCLUÍDAS.
# BUSCAR_ROTAS_DEMO=1
