# ==========================================================================
# Vambora — variáveis de ambiente (EXEMPLO)
# --------------------------------------------------------------------------
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA commite o arquivo ".env" real (ele está no .gitignore).
# NUNCA cole a chave "service_role" / secret aqui nem no frontend.
# ==========================================================================

# URL pública do projeto Supabase (aparece no painel do Supabase).
# Usada pelo navegador. Só é segura porque o acesso é protegido por RLS.
VITE_SUPABASE_URL=

# Chave PÚBLICA (publishable / anon) do Supabase.
# Pode ficar no frontend DESDE QUE as políticas RLS estejam corretas.
VITE_SUPABASE_ANON_KEY=

# Liga/desliga a camada real do Supabase. "false" = usa dados de demonstração.
# Na Etapa 1 deixe "false": a vitrine funciona 100% com dados de exemplo.
VITE_USE_SUPABASE=false
